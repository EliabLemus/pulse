# Copy to deploy/.env.techops. Never commit the real file.
# Every placeholder below must be replaced before deployment.

# Database password and URL must refer to the same user/password/database.
PULSE_DB_PASSWORD=CHANGE_TO_A_URL_SAFE_DATABASE_PASSWORD
DATABASE_URL=postgresql://pulse:CHANGE_TO_A_URL_SAFE_DATABASE_PASSWORD@db:5432/pulse

# Slack app credentials for the direct (non-OAuth) TechOps pilot.
SLACK_BOT_TOKEN=xoxb-REPLACE_ME
SLACK_SIGNING_SECRET=REPLACE_ME

# Generate with: openssl rand -hex 32
FLASK_SECRET_KEY=REPLACE_WITH_AT_LEAST_32_CHARACTERS

# The exact public HTTPS base URL configured in Slack, without a trailing slash.
APP_URL=https://pulse.example.com

# Local loopback port exposed to Caddy. Do not expose this directly to the Internet.
PULSE_PORT=3015

# Slack identifiers for the single-user pilot. IDs, not display names.
PULSE_TEAM_ID=T00000000
PULSE_TEAM_NAME=TechOps
PULSE_BOT_USER_ID=U00000000
PULSE_APP_ID=A00000000
PULSE_PARTICIPANT_ID=U00000000
PULSE_PARTICIPANT_NAME=Eliab
PULSE_CHANNEL_ID=G00000000
PULSE_MANAGER_ID=U00000000
